#the mod name as displayed in-game
displayName: "Singularity Reactors"

#the internal name of your mod
name: "singularity-reactors"

#your name
author: "LOLOCORD"

#the fully qualified main class of the mod
main: "singularity.SingularityMod"

#the mod description as seen in the mod dialog
description: "Reactores Alpha, Beta, Gamma y Omega. Generan energía masiva pero consumen recursos brutales. Incluye nodos mejorados."

#the mod version
version: 2.0.0

#the minimum game build required to run this mod
minGameVersion: 160.3

#this is a java mod
java: true
